# The hierophant's suite collar: the cut's self-proofs (totality, planted-leak
# sweep), the crate's cfg(test) modules.
#
# VEILED, withheld from delivery by its own perambulation row.

BKRR_COLLAR="rbvn_suite"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="vov_veiled/rbv0/Cargo.toml"
BKRR_TARGET="bknre_manifest"

# The app collar's election with its one exclusion lifted.
BKRR_ROOTS="vov_veiled/rbv0/src \
  vov_veiled/rbv0/build.rs \
  vov_veiled/rbv0/Cargo.toml \
  vov_veiled/rbv0/Cargo.lock \
  rust-toolchain.toml \
  Tools/bkk/bk0/bkp \
  :(exclude)Tools/bkk/bk0/bkp/src/bkpt*"

BKRR_FEATURES=""
BKRR_PROFILE="test"

# The totality proof reads the tracked tree and writes nothing.
BKRR_SPEND="bknre_reader"

BKRR_TAMED_CRATES="bkp"
BKRR_FERAL_CRATES="bknre_tamed"

BKRR_MUZZLE="."

BKRR_RUNNER="bknre_cargo"
BKRR_TONGUE="bknre_harness"

BKRR_EXERGUE="bknre_unstruck"
