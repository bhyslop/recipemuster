# The theurge's app collar: rbtd, the crucible test orchestrator every fixture
# and suite tabtarget launches.
#
# Law: specs/bkk/BKSCL-Collar.adoc. The instance directory's name is this
# collar's identity, and BKRR_COLLAR restates it.

BKRR_COLLAR="rbtdn_app"
BKRR_KIND="bknre_app"
BKRR_MANIFEST="Tools/rbk/rbtd/Cargo.toml"
BKRR_TARGET="rbt"

# The crate's own source and manifests, with its cfg(test) modules carved out:
# the binary is not compiled from them. The repository pin answers for this
# crate's channel, so it is elected beside them.
BKRR_ROOTS="Tools/rbk/rbtd/src \
  Tools/rbk/rbtd/build.rs \
  Tools/rbk/rbtd/Cargo.toml \
  Tools/rbk/rbtd/Cargo.lock \
  rust-toolchain.toml \
  :(exclude)Tools/rbk/rbtd/src/rbtdt*"

BKRR_FEATURES=""

# Cargo's dev profile, so the heel's build output is the residence below and
# every reader of the theurge's binary finds it where it always stood.
BKRR_PROFILE="dev"

# A READER, and the reason is what a pin would cost: the theurge exists to test
# the tree it stands in, so it must always run the seat's own build. What its
# fixtures write, they write through that tree's own tabtargets.
BKRR_SPEND="bknre_reader"

BKRR_TAMED_CRATES="tungstenite \
  arboard"

# Nothing feral in this closure; the field is asked at every collar
# (BKSCL-Collar.adoc "The tamed and the feral").
BKRR_FERAL_CRATES="bknre_tamed"

BKRR_MUZZLE="."

# THE BUILD OUTPUT IS THE RESIDENCE, the binary standing where cargo built it.
BKRR_RESIDENCE="Tools/rbk/rbtd/target/debug"
BKRR_BYNAME="rbt"

# NO STRUCK FILE STANDS IN THIS COMPILE. The colophon constants module the build
# door regenerates from the zipper (Tools/rbk/rbtd/src/rbtdgc_consts.rs) is the
# build door's own act and is committed, so it stands on every seat and carries
# no landed reading; it is not an exergue in the kennel's sense. The position
# the binary answers --exergue with is compiled in by the crate's build script.
BKRR_EXERGUE="bknre_unstruck"
