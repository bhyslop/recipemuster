# The theurge's suite collar: the crate's cfg(test) modules, the unit tests
# tt/rbw-tt.Test.sh runs. The crucible fixtures are the theurge's own runs of
# its binary and are not this suite.

BKRR_COLLAR="rbtdn_suite"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="Tools/rbk/rbtd/Cargo.toml"
BKRR_TARGET="bknre_manifest"

# The app collar's election with its one exclusion lifted: the rbtdt* modules
# are what this suite is made from.
BKRR_ROOTS="Tools/rbk/rbtd/src \
  Tools/rbk/rbtd/build.rs \
  Tools/rbk/rbtd/Cargo.toml \
  Tools/rbk/rbtd/Cargo.lock \
  rust-toolchain.toml"

BKRR_FEATURES=""
BKRR_PROFILE="test"
BKRR_SPEND="bknre_reader"

BKRR_TAMED_CRATES="tungstenite \
  arboard"

# Nothing feral in this closure; the field is asked at every collar
# (BKSCL-Collar.adoc "The tamed and the feral").
BKRR_FERAL_CRATES="bknre_tamed"

BKRR_MUZZLE="."

# CARGO'S OWN RUNNER, the invocation this suite always ran under.
BKRR_RUNNER="bknre_cargo"
BKRR_TONGUE="bknre_harness"

# NO STRUCK FILE STANDS IN THIS COMPILE. The colophon constants module the build
# door regenerates from the zipper (Tools/rbk/rbtd/src/rbtdgc_consts.rs) is the
# build door's own act and is committed, so it stands on every seat and carries
# no landed reading; it is not an exergue in the kennel's sense. The position
# the binary answers --exergue with is compiled in by the crate's build script.
BKRR_EXERGUE="bknre_unstruck"
