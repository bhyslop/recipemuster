# THE HAYLOFT TOOL'S APP COLLAR — one binary carrying bale and unbale.
#
# Wean it by copying this directory whole into your weaned set, then heel it.
# Its two tabtargets, bkw-A and bkw-u, launch it through mush as a step.

BKRR_COLLAR="bkhln_app"
BKRR_KIND="bknre_app"
BKRR_MANIFEST="Tools/bkk/bkhl0/Cargo.toml"

# The binary target the manifest names.
BKRR_TARGET="bkhl"

BKRR_FEATURES=""

# NAMED, since the built binary is found by it.
BKRR_PROFILE="release"

# THE APP WRITES: bale removes what it archives. A writer is always launched
# from the installed binary at its residence, so a worktree's own build never
# touches the folders a machine keeps. It is never asked --exergue, so the crate
# carries no build script.
BKRR_SPEND="bknre_writer"

# Every direct dependency: the archive's reader and writer, its compressor, and
# the floor's regime reader.
BKRR_TAMED_CRATES="tar \
  flate2 \
  bkp"
BKRR_FERAL_CRATES="bknre_tamed"

# The consuming tree's own lint list, at its root.
BKRR_MUZZLE="."

# THE BUILD OUTPUT IS THE RESIDENCE, the binary standing where cargo built it
# under the crate's own target directory.
BKRR_RESIDENCE="Tools/bkk/bkhl0/target/release"
BKRR_BYNAME="bkhl"

# No generated source stands in this compile.
BKRR_EXERGUE="bknre_unstruck"
