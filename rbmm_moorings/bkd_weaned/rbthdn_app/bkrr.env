# The hierophant's app collar: rbthd, the delivery-ceremony conductor.
#
# VEILED, withheld from delivery by its own perambulation row, as the crate it
# declares is.

BKRR_COLLAR="rbthdn_app"
BKRR_KIND="bknre_app"
BKRR_MANIFEST="vov_veiled/rbthd/Cargo.toml"
BKRR_TARGET="rbthd"

# The crate's own source and manifests, with its cfg(test) modules carved out.
# The repository pin answers for this crate's channel.
BKRR_ROOTS="vov_veiled/rbthd/src \
  vov_veiled/rbthd/build.rs \
  vov_veiled/rbthd/Cargo.toml \
  vov_veiled/rbthd/Cargo.lock \
  rust-toolchain.toml \
  :(exclude)vov_veiled/rbthd/src/rbthdt*"

BKRR_FEATURES=""
BKRR_PROFILE="dev"

# A WRITER: the ceremony cuts, pushes and promotes, which is shared durable
# state, so a wrong vintage must never conduct it.
BKRR_SPEND="bknre_writer"

# EMPTY, AND THE EMPTINESS IS THE DECLARATION: the crate needs only std, so
# anything that links in later is a finding.
BKRR_TAMED_CRATES=""
BKRR_FERAL_CRATES="bknre_tamed"

BKRR_MUZZLE="."

# THE BUILD OUTPUT IS THE RESIDENCE.
BKRR_RESIDENCE="vov_veiled/rbthd/target/debug"
BKRR_BYNAME="rbthd"

# No generated source stands in this compile.
BKRR_EXERGUE="bknre_unstruck"
