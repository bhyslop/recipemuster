# The regime reader's suite collar — the last row the first roster left owed.
#
# The reader stands beside the kennel as a crate of its own, and the collar
# sheaf's grain gives every launchable one collar. Until this file stood, the
# kennelman was the only door that could reach these hurdles, and no kennel door
# ever could: a crate wearing no collar is invisible to a walk that finds
# launchables by finding family files.
#
# NO APP COLLAR STANDS BESIDE THIS ONE, and never will. The reader is a library
# and nothing else — it answers a question and holds no posture about what to do
# with the answer — so it has no binary artifact to declare.

BKRR_COLLAR="bkln_suite"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="Tools/bkk/bk0/bkl/Cargo.toml"

# THE WHOLE-MANIFEST FORM, and here it is the only form available rather than
# the convenient one: the reader holds no tests/ directory at all, only cfg(test)
# modules under src, so cargo's namespace carries no test-target name to name.
BKRR_TARGET="bknre_manifest"

# THE CRATE'S OWN DIRECTORY, WHOLE. The reader depends on nothing — no path
# dependency, no registry crate — so the closure the validate door audits this
# election against is the crate itself and stops there. It is elected whole
# rather than carved: the kennel's own suite carves bkt* modules out of the
# BINARY's election because cfg(test) cannot change a built binary, and there is
# no binary here to make that distinction against.
#
# THE PIN IS NOT ELECTED, on the sibling suites' precedent. The reader states no
# pin of its own and the kit's governs it, and a root set naming a file outside
# the crate would make this collar's currency answer for a bump the crate does
# not carry.
BKRR_ROOTS="Tools/bkk/bk0/bkl"

BKRR_FEATURES=""
BKRR_PROFILE="test"

# The reader reads. It opens a regime file and returns what stands in it; no
# path it takes writes anything, shared or otherwise.
BKRR_SPEND="bknre_reader"

# EMPTY, AND THE EMPTINESS IS THE DECLARATION rather than an unfilled field. The
# manifest's own [dependencies] stands empty on the same ground — a regime file
# is read with std alone, and a parser crate under the one thing in the estate
# whose whole promise is that it reads exactly what bash reads would put a
# dependency closure beneath that promise. The allow form names every direct
# dependency, so a list of none is the strongest form this field takes: anything
# that links in later is a finding at the next drive.
BKRR_TAMED_CRATES=""

# Nothing feral in this closure; the field is asked at every collar
# (BKSCL-Collar.adoc "The tamed and the feral").
BKRR_FERAL_CRATES="bknre_tamed"

# The repository root, as the kennel's own collar names it. The muzzle is the
# consuming tree's governance and not the kit's, and this crate rides out to
# consumers inside Tools/bkk carried whole.
BKRR_MUZZLE="."

# CARGO'S OWN RUNNER, matching what the kennelman already spawns for this crate.
# One suite names one runner whichever door reaches it, and the kennelman keeps
# driving the reader first — a reader whose only proof ran through its first
# consumer could not be the crate the estate's other readers converge onto — so a
# collar naming the other runner would make the two doors read a verdict off
# different exit codes.
BKRR_RUNNER="bknre_cargo"
BKRR_TONGUE="bknre_harness"

# NO GENERATED SOURCE STANDS IN THIS COMPILE. Declared rather than left silent:
# a door reading "nothing is generated here" out of an ABSENCE cannot tell a
# declaration from an omission, which is the distinction the validate door
# exists to draw.
BKRR_EXERGUE="bknre_unstruck"
