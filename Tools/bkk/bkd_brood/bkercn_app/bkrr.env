# THE HELLO EXEMPLAR'S ATTENDED APP COLLAR — a rust binary that speaks the
# kennel's own tongue, declared.
#
# It proves the attended app: the crate's second binary prints one line per case
# in the kennel's own tongue, so the launch door runs it as a captured child and
# reads it as it reads a suite — the console carrying the verdict, the record the
# whole stream, a skipped case named in the verdict and never counted as run.
# Beside it, bkern_app declares no tongue and holds the terminal. Wean it by
# copying this directory whole into your weaned set.

BKRR_COLLAR="bkercn_app"
BKRR_KIND="bknre_app"
BKRR_MANIFEST="Tools/bkk/bke0/bker/Cargo.toml"

# The binary target the manifest names.
BKRR_TARGET="bkerc"

BKRR_FEATURES=""

# NAMED, since the built binary is found by it.
BKRR_PROFILE="release"

# THE APP READS; it writes nothing shared. A reader launches only where it
# answers --exergue with the position it was struck from, which the crate's
# build script compiles in.
BKRR_SPEND="bknre_reader"

# EMPTY, AND THE EMPTINESS IS THE DECLARATION: the crate has no dependency to
# name, so anything that links in later is a finding.
BKRR_TAMED_CRATES=""
BKRR_FERAL_CRATES="bknre_tamed"

# The consuming tree's own lint list, at its root.
BKRR_MUZZLE="."

# THE BUILD OUTPUT IS THE RESIDENCE, the binary standing where cargo built it
# under the crate's own target directory.
BKRR_RESIDENCE="Tools/bkk/bke0/bker/target/release"
BKRR_BYNAME="bkerc"

# No generated source stands in this compile.
BKRR_EXERGUE="bknre_unstruck"

# THE TONGUE IS WHAT MAKES THE APP ATTENDED: the kennel's own, one bare line per
# case, a verdict word and then the case name.
BKRR_TONGUE="bknre_passfail"
