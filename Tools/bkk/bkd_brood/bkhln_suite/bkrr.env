# THE HAYLOFT TOOL'S SUITE COLLAR — the crate's whole test set, declared.
#
# Every hurdle composes a project of its own beneath the dispatch's temp
# directory and never reaches a machine's real folders. Wean it by copying this
# directory whole into your weaned set.

BKRR_COLLAR="bkhln_suite"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="Tools/bkk/bkhl0/Cargo.toml"

# EVERY TEST OF THE MANIFEST: the library's own test modules and the
# integration hurdle that drives the built binary.
BKRR_TARGET="bknre_manifest"
BKRR_FEATURES=""
BKRR_PROFILE="test"
BKRR_SPEND="bknre_reader"
BKRR_TAMED_CRATES="tar \
  flate2 \
  brp"
BKRR_FERAL_CRATES="bknre_tamed"
BKRR_MUZZLE="."

# CARGO'S OWN RUNNER, as the floor's suite takes it.
BKRR_RUNNER="bknre_cargo"
BKRR_TONGUE="bknre_harness"

BKRR_EXERGUE="bknre_unstruck"
