# THE TORCH EXEMPLAR'S SUITE COLLAR — a suite over torch from PyPI alone, a
# closure whose wheels differ by platform.
#
# A suite-only project wears one collar. Wean it by copying this directory whole
# into your weaned set; its first converge downloads the closure into the
# station's wheel cache, and every later one installs from there.

BKRP_COLLAR="bketn_suite"
BKRP_KIND="bknre_suite"
BKRP_MANIFEST="Tools/bkk/bke0/bket/pyproject.toml"
BKRP_ROOTS="Tools/bkk/bke0/bket"
BKRP_SPEND="bknre_reader"

# THE DIRECT DEPENDENCIES PARTED BY HOW THEY ARRIVE. Every direct dependency the
# lock's own account of the manifest carries stands in exactly one list, spelled
# as the lock spells it: here NumPy and torch as wheels for every platform their lock covers, and the test runner.
# A package that would be built from its source on some station the lock
# covers would stand in the second list, which admits bknre_baked alone — such a
# package is refused, never built (BKr_hpt).
BKRP_BAKED_PACKAGES="numpy torch pytest"
BKRP_CRUDE_PACKAGES="bknre_baked"
BKRP_TARGET="bknre_manifest"
BKRP_RUNNER="bknre_pytest"
BKRP_TONGUE="bknre_pytest"
