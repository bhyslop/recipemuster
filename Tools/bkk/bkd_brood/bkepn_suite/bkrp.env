# THE HELLO EXEMPLAR'S SUITE COLLAR — the project's whole suite, declared.
#
# One project carries this suite and the app beside it, each launchable wearing
# a collar of its own. Wean it by copying this directory whole into your weaned
# set.

BKRP_COLLAR="bkepn_suite"
BKRP_KIND="bknre_suite"
BKRP_MANIFEST="Tools/bkk/bke0/bkep/pyproject.toml"
BKRP_ROOTS="Tools/bkk/bke0/bkep"
BKRP_SPEND="bknre_reader"

# THE DIRECT DEPENDENCIES PARTED BY HOW THEY ARRIVE. Every direct dependency the
# lock's own account of the manifest carries stands in exactly one list, spelled
# as the lock spells it: here the test runner the project's dev group declares.
# A package that would be built from its source on some station the lock
# covers would stand in the second list, which admits bknre_baked alone — such a
# package is refused, never built (BKr_hpt).
BKRP_BAKED_PACKAGES="pytest"
BKRP_CRUDE_PACKAGES="bknre_baked"

# THE WHOLE PROJECT'S TESTS, as the runner's own configuration finds them in the
# manifest. No narrower target is named.
BKRP_TARGET="bknre_manifest"

# pytest is the one runner this family admits, and the output shape the kennel
# reads is declared beside it rather than inferred from it.
BKRP_RUNNER="bknre_pytest"
BKRP_TONGUE="bknre_pytest"
