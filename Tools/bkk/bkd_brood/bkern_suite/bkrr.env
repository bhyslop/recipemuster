# THE HELLO EXEMPLAR'S SUITE COLLAR — the crate's whole test set, declared.
#
# One crate carries this suite and the app beside it, each launchable wearing a
# collar of its own. Wean it by copying this directory whole into your weaned
# set.

BKRR_COLLAR="bkern_suite"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="Tools/bkk/bke0/bker/Cargo.toml"

# EVERY TEST OF THE MANIFEST. The suite is the binary's own cfg(test) module, so
# no narrower test target is named.
BKRR_TARGET="bknre_manifest"
BKRR_ROOTS="Tools/bkk/bke0/bker"
BKRR_FEATURES=""
BKRR_PROFILE="test"
BKRR_SPEND="bknre_reader"
BKRR_TAMED_CRATES=""
BKRR_FERAL_CRATES="bknre_tamed"
BKRR_MUZZLE="."

# CARGO'S OWN RUNNER, which needs no kibble weaned beside it, and the output
# shape the kennel reads declared beside it rather than inferred from it.
BKRR_RUNNER="bknre_cargo"
BKRR_TONGUE="bknre_harness"

BKRR_EXERGUE="bknre_unstruck"
