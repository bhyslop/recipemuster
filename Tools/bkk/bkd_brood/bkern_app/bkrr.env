# THE HELLO EXEMPLAR'S APP COLLAR — a rust binary, declared.
#
# The kennel ships this collar so a station can prove its rust tenant on a crate
# nothing else depends on, and so an author can read what a rust app collar
# carries. Wean it by copying this directory whole into your weaned set.

BKRR_COLLAR="bkern_app"
BKRR_KIND="bknre_app"
BKRR_MANIFEST="Tools/bkk/bke0/bker/Cargo.toml"

# The binary target the manifest names.
BKRR_TARGET="bker"

# The crate's directory, whole. It has no local dependency to reach.
BKRR_ROOTS="Tools/bkk/bke0/bker"

BKRR_FEATURES=""

# NAMED, since the built binary is found by it.
BKRR_PROFILE="release"

# THE APP READS; it writes nothing shared. A reader launches only where it
# answers --exergue with the position it was struck from, which the crate's
# build script compiles in.
BKRR_SPEND="bknre_reader"

# EMPTY, AND THE EMPTINESS IS THE DECLARATION: the crate has no dependency to
# name, so anything that links in later is a finding.
BKRR_TAMED_CRATES=""
BKRR_FERAL_CRATES="bknre_tamed"

# The consuming tree's own lint list, at its root.
BKRR_MUZZLE="."

# THE BUILD OUTPUT IS THE RESIDENCE, the binary standing where cargo built it
# under the crate's own target directory.
BKRR_RESIDENCE="Tools/bkk/bke0/bker/target/release"
BKRR_BYNAME="bker"

# No generated source stands in this compile.
BKRR_EXERGUE="bknre_unstruck"
