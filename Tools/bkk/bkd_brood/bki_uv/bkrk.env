# UV'S KIBBLE — the first of the prebuilt kind, and the pin the python tenant
# stands on.
#
# The estate's python provisioning fetched uv from the vendor installer and
# verified it against a per-platform sha table kept true by hand
# (specs/bkk/BKSPY-Python.adoc). This declaration is what retires that
# table: one seal over one document, and the document is the vendor's own.
#
# THE PREBUILT KIND, AND THE REASON IS A FACT ABOUT UV RATHER THAN A PREFERENCE.
# It asks a rustc above the estate's own pin and cmake for the TLS library it
# links, so it cannot be built here; its release publishes a single document
# naming every archive by rust target triple with that archive's sha256, so it
# can be fetched prebuilt (BKSBL-Kibble.adoc "What sorts them").

BKRK_KIBBLE="bki_uv"
BKRK_KIND="bknre_prebuilt"

# The program, and the name its binary wears at its residence. The release also
# carries `uvx` beside it; a kibble declares the one binary it pins, and a
# second program pinned from the same release would be a second kibble.
BKRK_PROGRAM="uv"
BKRK_BYNAME="uv"

# THE VERSION HAS ONE HOME AND THIS IS IT. The door joins it between the store
# and the document below, so a bump is this line alone and cannot leave a stale
# URL standing behind it.
BKRK_VERSION="0.11.30"

# The sha256 of the bordereau named below, read on this station 260908 by the
# openssl stdin form the seal is proven with. The vendor publishes a `.sha256`
# beside every ARCHIVE of the release but none beside the document itself, so
# this digest is the estate's own reading rather than a restatement of a
# published one — which is what a seal over a document is for: the archives'
# digests are the document's to state, and this is what answers for the
# document.
BKRK_SEAL="1ffc1aef24d13b7d39a5cc27d74482ab6807193ba6cda547116f3fa45180c114"

# The store the vendor's releases stand in, one directory per version. The
# version is NEVER typed in here.
BKRK_LARDER="https://github.com/astral-sh/uv/releases/download"

# The document in that release naming every archive by rust target triple with
# its digest. The name is cargo-dist's rather than uv's own, which is exactly
# why it is declared here: a kennel that spelled it would be holding a fact
# about a release-tooling family it has no other reason to know.
BKRK_BORDEREAU="dist-manifest.json"

# eof
