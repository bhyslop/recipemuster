# THE HELLO EXEMPLAR'S APP COLLAR — a python entry point, declared.
#
# The kennel ships this collar so a station can prove its python tenant on a
# project nothing else depends on, and so an author can read what a python app
# collar carries. Wean it by copying this directory whole into your weaned set.

BKRP_COLLAR="bkepn_app"
BKRP_KIND="bknre_app"

# THE PROJECT'S OWN MANIFEST, joined from the repository root. Its lock and its
# pin stand beside it and are named by uv, never by the collar.
BKRP_MANIFEST="Tools/bkk/bke0/bkep/pyproject.toml"

# The project's directory, whole.
BKRP_ROOTS="Tools/bkk/bke0/bkep"

# The app reads; it writes nothing shared.
BKRP_SPEND="bknre_reader"

# THE DIRECT DEPENDENCIES PARTED BY HOW THEY ARRIVE. Every direct dependency the
# lock's own account of the manifest carries stands in exactly one list, spelled
# as the lock spells it: here the test runner the project's dev group declares, the one environment per project carrying it for the app and the suite alike.
# A package that would be built from its source on some station the lock
# covers would stand in the second list, which admits bknre_baked alone — such a
# package is refused, never built (BKr_hpt).
BKRP_BAKED_PACKAGES="pytest"
BKRP_CRUDE_PACKAGES="bknre_baked"

# THE NAME THE ENTRY POINT ANSWERS TO in the environment the converge sites,
# which is the project's own [project.scripts] key. No residence is declared: a
# python entry point stands only in that environment, which the kennel places.
BKRP_BYNAME="bkep"
