# The parcel engine's suite collar.
#
# The crate is never built standalone and is TESTED standalone by design, cargo
# testing only the manifest it is handed. It ships in this kit's brood, so a
# repository receiving the kit can wean it and prove the engine it mints with.

BKRR_COLLAR="bpen_suite"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="Tools/bpk/bpe/Cargo.toml"
BKRR_TARGET="bknre_manifest"

# The crate whole — its cfg(test) modules stand under src and are what this
# suite is made from — the one local crate its closure reaches, with that
# crate's own test arm carved out, and the three templates the install
# compiles in from this kit's directory.
BKRR_ROOTS="Tools/bpk/bpe \
  Tools/bkk/bk0/bkp \
  :(exclude)Tools/bkk/bk0/bkp/src/bkpt* \
  Tools/bpk/bpt_burc.env \
  Tools/bpk/bpt_launcher.sh \
  Tools/bpk/bpt_station.sh"

BKRR_FEATURES=""
BKRR_PROFILE="test"
BKRR_SPEND="bknre_reader"

BKRR_TAMED_CRATES="serde_json \
  bkp"

# Nothing feral in this closure; the field is asked at every collar.
BKRR_FERAL_CRATES="bknre_tamed"

BKRR_MUZZLE="Tools/bpk/bpe"

BKRR_RUNNER="bknre_nextest"
BKRR_TONGUE="bknre_nextest"

# NO GENERATED SOURCE STANDS IN THIS COMPILE. Declared rather than left silent:
# a door reading "nothing is generated here" out of an ABSENCE cannot tell a
# declaration from an omission, which is the distinction the validate door
# exists to draw.
BKRR_EXERGUE="bknre_unstruck"
