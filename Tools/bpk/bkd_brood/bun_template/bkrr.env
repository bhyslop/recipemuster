# The substrate's second suite — the one hurdle holding the starter kit's seed
# templates against what the substrate's launcher and tabtarget doors emit.
#
# A SUBSTRATE COLLAR IN THE STARTER KIT'S BROOD, and the brood is the point. The
# hurdle reads the templates by path, so it can run only where the starter kit
# stands; a repository carrying the substrate without that kit would race it red
# for want of a file it was never meant to hold. Veiling rides the brood's
# location (BKSCL-Collar.adoc "Container and Discovery"): a brood under a kit the
# parcel does not carry ships nothing, so this collar reaches a repository with
# the templates and no other. The crate it declares is the substrate's
# self-test, standing in the kennel kit at Tools/bkk/but0, and the target stands
# out of the substrate suite's run under cargo's own `test = false`.

BKRR_COLLAR="bun_template"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="Tools/bkk/but0/Cargo.toml"
BKRR_TARGET="butt-template"

# THE SUBSTRATE SUITE'S ELECTION, AND THE TEMPLATES. The crate's lib and the
# kennel whole compile here exactly as they do for the substrate's suite, on the
# ground its collar states for naming the kennel whole.
#
# THE OTHER TEST FILES ARE OVER-ELECTED, on that same ruling. Only this target's
# file is compiled of the crate's tests, but the crate stands beneath the kennel
# named whole, and a git exclusion beats an include: no root list can name the
# kennel whole and carve the crate's tests back out save this one file. So the
# election takes them all, and a position moves when a sibling test does — the
# over-election whose cost is a needless move, never a stale reading behind a
# green verdict.
#
# The two templates are named because they are what the course judges, and the
# one thing it reads that the kennel's tree does not hold. The substrate's bash
# stays out on that suite's footing, none of it being compiled.
BKRR_ROOTS="Tools/bkk \
  Tools/bkk/bk0/bkp \
  :(exclude)Tools/bkk/bk0/bkp/src/bkpt* \
  Tools/bpk/bpt_launcher.sh \
  Tools/bpk/bpt_tabtarget.sh"

BKRR_FEATURES=""
BKRR_PROFILE="test"
BKRR_SPEND="bknre_reader"

# The substrate crate's two direct dependencies, as its suite names them.
BKRR_TAMED_CRATES="bkk \
  bkp"

# Nothing feral in this closure; the field is asked at every collar
# (BKSCL-Collar.adoc "The tamed and the feral").
BKRR_FERAL_CRATES="bknre_tamed"

# The repository root. A muzzle is the governance of the tree being linted and
# travels with that tree, never with the kit reading it.
BKRR_MUZZLE="."

# Cargo's own runner, matching the substrate's suite over the same crate.
BKRR_RUNNER="bknre_cargo"
BKRR_TONGUE="bknre_harness"

# No generated source stands in this compile.
BKRR_EXERGUE="bknre_unstruck"
