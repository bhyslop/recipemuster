# The parcel engine's app collar: bpx, the install binary every parcel carries.
#
# It ships in this kit's brood beside the suite, so a repository receiving the
# kit can wean it and converge the binary its own parcels will carry.

BKRR_COLLAR="bpen_app"
BKRR_KIND="bknre_app"
BKRR_MANIFEST="Tools/bpk/bpe/Cargo.toml"
BKRR_TARGET="bpx"

# The suite collar's roots: the crate whole, the one local crate its closure
# reaches with that crate's own test arm carved out, and the three templates the
# install compiles in from this kit's directory. Held equal to the suite's, so
# the two collars over one crate state one position into one build directory.
BKRR_ROOTS="Tools/bpk/bpe \
  Tools/bkk/bk0/bkp \
  :(exclude)Tools/bkk/bk0/bkp/src/bkpt* \
  Tools/bpk/bpt_burc.env \
  Tools/bpk/bpt_launcher.sh \
  Tools/bpk/bpt_station.sh"

BKRR_FEATURES=""
BKRR_PROFILE="release"

# A reader: the binary compiles in the position the converge states and prints
# it when asked --exergue. It writes the target it is handed and no store a
# second vintage could corrupt.
BKRR_SPEND="bknre_reader"

BKRR_TAMED_CRATES="serde_json \
  bkp"

# Nothing feral in this closure; the field is asked at every collar.
BKRR_FERAL_CRATES="bknre_tamed"

BKRR_MUZZLE="Tools/bpk/bpe"

BKRR_RESIDENCE="Tools/bpk/bpe/target/release"

# Nothing renames this one, so the byname restates the target. Declared anyway:
# a door reading the name out of an ABSENCE cannot tell a declaration from an
# omission, which is the distinction the validate door exists to draw.
BKRR_BYNAME="bpx"

# NO GENERATED SOURCE STANDS IN THIS COMPILE: the position arrives by the
# converge's environment, never by a file.
BKRR_EXERGUE="bknre_unstruck"
