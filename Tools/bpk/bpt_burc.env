##########################################
# TEMPLATE — the config regime a repository declares before its first install.
#
# Copy to your own moorings directory as `burc.env`, fill every «...»
# substitution, and delete this template header block. Guillemets mark the
# boundary between what this kit says and what only you can say; a guillemet
# left standing is an unfinished file.
#
# The install door reads three of these variables and refuses without them:
# BURC_PROJECT_ROOT, BURC_TOOLS_DIR and BURC_MANAGED_KITS. BURC_ENDONYM declares
# this repository's own identity, the other eight are the dispatch's, and the
# config regime validator refuses a file that declares fewer or more than the
# twelve below.
#
# This file is sourced by bash. No spaces are allowed around `=`.
# Only declare variables here. If you define any variables in terms
# of others, use ${xxx} to expand.

# The station file, per-machine and never committed. Resolved from the REPOSITORY
# ROOT rather than from this file, so the value below names a sibling of the
# repository and stands outside it.
BURC_STATION_FILE=../station-files/burs.env

# The tabtarget directory, at the repository root.
BURC_TABTARGET_DIR=tt

# The token separator in tabtarget filenames.
BURC_TABTARGET_DELIMITER=.

# Where installed kits stand. The install door writes only under here, plus
# `.vvm/` and `.claude/`.
BURC_TOOLS_DIR=Tools

# The repository root, expressed relative to THIS FILE — the one variable here
# that is. A moorings directory sitting one level down makes this `..`.
BURC_PROJECT_ROOT=..

# This repository's own identity, declared here and derived from nothing: the
# head buon_, then a lowercase tail of a leading letter and further letters and
# digits, distinct from every other repository's.
BURC_ENDONYM=buon_«lowercase-tail-naming-this-repository»

# The kits this repository receives by parcel. A release cut for this
# repository carries exactly these, refusing where its forge holds any of them
# as no tracked folder; an install takes only the kits both the parcel and this
# list name, and refuses only where the two share none, so it is the list — not
# the parcel — that decides what may land here. A forge declares only what it
# receives itself, which is nothing where it authors every kit it holds.
BURC_MANAGED_KITS=«comma-separated-kit-list,-no-spaces»

# Scratch, output and build-product roots. All three stand OUTSIDE the
# repository so no door's own writing can dirty the tree.
BURC_TEMP_ROOT_DIR=../temp-buk
BURC_OUTPUT_ROOT_DIR=../output-buk
BURC_LOOSEBOX_ROOT_DIR=../loosebox-buk

# Log filename stem and extension.
BURC_LOG_LAST=last
BURC_LOG_EXT=txt
